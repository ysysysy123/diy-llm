  "cards": [
    {
      "dot": "cyan",
      "title": "建议学习顺序",
      "items": [
        "先完成第 2 章 tokenizer，再接第 3 章资源核算",
        "第 4 章只抓住 RoPE、RMSNorm、SwiGLU、AdamW 和训练细节",
        "每一步都记录输入、输出 shape 与可运行测试"
      ]
    },
    {
      "dot": "emerald",
      "title": "作业 1 的验收",
      "items": [
        "tokenizer 能训练、编码、解码并解释边界",
        "model 能从 token ids 得到 logits",
        "optimizer 更新前后能说明参数和 loss 的变化"
      ]
    },
    {
      "dot": "amber",
      "title": "范围边界",
      "items": [
        "MoE、Scaling、对齐和完整六次作业不是当前首次求职硬指标",
        "遇到问题优先回到数据、shape、loss 和资源核算",
        "不要用跑通脚本替代理解实现"
      ]
    }
